NODE_ENV=development
PORT=3000

# Cloud database (Neon): if DATABASE_URL is set, the DB_* variables are ignored
# Base de datos en la nube (Neon): si DATABASE_URL existe, se ignoran las DB_*
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleetcore
DB_SYNC=true

JWT_SECRET=cambia-este-secreto-por-uno-largo
JWT_EXPIRES_IN=1h

API_KEYS=demo-key-partner-1,demo-key-partner-2
